{
  "name": "restricted",
  "description": "Tighter guardrails for regulated or production-facing services.",
  "required_tags": ["owner", "environment", "service", "cost_center", "data_classification"],
  "allowed_regions": ["us-east-1", "us-west-2"],
  "allowed_instance_families": ["t3", "m7i"],
  "restricted_allowlist": [
    "aws_security_group",
    "aws_s3_bucket",
    "aws_s3_bucket_public_access_block",
    "aws_s3_bucket_server_side_encryption_configuration",
    "aws_iam_policy",
    "aws_iam_role_policy",
    "aws_db_instance"
  ],
  "max_monthly_delta": 250,
  "block_public_admin_ingress": true,
  "require_cost_center": true,
  "block_production_stateful_deletes": true,
  "require_deletion_protection_in_prod": true,
  "min_prod_backup_retention_days": 14
}
